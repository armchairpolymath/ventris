<?xml version="1.0" encoding="UTF-8"?>
<!-- G-code highlighting for GtkSourceView 5 -->
<language id="gcode" name="G-code" version="2.0" _section="Other">
  <metadata>
    <property name="globs">*.gcode;*.gco;*.nc;*.ngc</property>
    <property name="line-comment-start">;</property>
  </metadata>
  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="gcode" name="G command" map-to="def:keyword"/>
    <style id="mcode" name="M command" map-to="def:function"/>
    <style id="tcode" name="Tool change" map-to="def:type"/>
    <style id="axis" name="Parameter letter" map-to="def:identifier"/>
    <style id="number" name="Number" map-to="def:number"/>
  </styles>
  <definitions>
    <context id="gcode">
      <include>
        <context id="comment" style-ref="comment" end-at-line-end="true">
          <start>;</start>
        </context>
        <context id="paren-comment" style-ref="comment">
          <start>\(</start>
          <end>\)</end>
        </context>
        <context id="gcode-word" style-ref="gcode">
          <match>\b[Gg]\d+(\.\d+)?</match>
        </context>
        <context id="mcode-word" style-ref="mcode">
          <match>\b[Mm]\d+(\.\d+)?</match>
        </context>
        <context id="tcode-word" style-ref="tcode">
          <match>\b[Tt]\d+</match>
        </context>
        <context id="param">
          <match>([A-Za-z])([-+]?(\d+\.?\d*|\.\d+))</match>
          <include>
            <context sub-pattern="1" style-ref="axis"/>
            <context sub-pattern="2" style-ref="number"/>
          </include>
        </context>
      </include>
    </context>
  </definitions>
</language>
